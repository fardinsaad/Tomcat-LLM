# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored -- never commit real keys.

# GPT-4o  (llm.py)
OPENAI_API_KEY=your-openai-key-here

# Gemma-3-27B and Gemini  (gemma.py / gemini.py)
GEMINI_API_KEY=your-gemini-key-here

# DeepSeek-R1  (deepseek.py)
DEEPSEEK_API_KEY=your-deepseek-key-here

# Claude  (claude.py) -- used via the Anthropic OpenAI-compatible endpoint
# base_url = https://api.anthropic.com/v1/
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: HuggingFace, for locally hosted models
HF_TOKEN=your-hf-token-here
