# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored -- never commit real keys.

# ---------------------------------------------------------------------------
# Models used in the published Doors, Keys, and Gems study
# ---------------------------------------------------------------------------

# GPT-4o  (llm.py)  -- first-party OpenAI
OPENAI_API_KEY=your-openai-key-here

# DeepSeek-R1  (deepseek.py)  -- served through the Hugging Face router.
# `deepseek-reasoner` was retired on 2026-07-24; R1 is MIT-licensed and still
# hosted, so we reach the SAME weights rather than substituting a newer model.
HF_TOKEN=your-huggingface-token-here

# Gemma-3-27B  (gemma.py)  -- served through OpenRouter.
# Deprecated on Google AI Studio; OpenRouter still routes to full-precision
# hosts. NOTE the name: OPENROUTER_API_KEY, not OPENROUTER.
OPENROUTER_API_KEY=your-openrouter-key-here

# ---------------------------------------------------------------------------
# Models for the Environment Generalizability study (Overcooked, Sci-Collab)
# ---------------------------------------------------------------------------

# DeepSeek V4  (deepseek_v4.py)  -- first-party DeepSeek, current generation
DEEPSEEK_API_KEY=your-deepseek-key-here

# Claude  (claude.py) -- Anthropic's OpenAI-compatible endpoint
ANTHROPIC_API_KEY=your-anthropic-key-here

# Gemini  (gemini.py)
GEMINI_API_KEY=your-gemini-key-here
