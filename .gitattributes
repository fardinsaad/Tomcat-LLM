# Normalise line endings. Without this, editing on Windows (or syncing through
# Google Drive) rewrites every file as CRLF, and git reports every line of
# every file as changed -- which is exactly the state Tomcat-LLM is in.
#
# One-time fix after adding this file:
#     git add --renormalize .
#     git commit -m "Normalise line endings to LF"
* text=auto eol=lf

# Grid/state files are parsed character-by-character. Force LF so a CRLF
# checkout can never introduce a stray \r into a row.
*.txt   text eol=lf
*.pddl  text eol=lf

# Notebooks are JSON; keep them LF so diffs stay readable.
*.ipynb text eol=lf

# Binary -- never touch.
*.png   binary
*.pdf   binary
*.xlsx  binary
*.docx  binary
*.pptx  binary
